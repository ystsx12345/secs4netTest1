<Window x:Class="secs4netTest1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:secs4netTest1"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 连接配置 -->
        <Border Grid.Row="0"
                BorderBrush="#DDD"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="监听IP:"
                           VerticalAlignment="Center" />
                <TextBox x:Name="txtIp"
                         Width="120"
                         Text="127.0.0.1"
                         Margin="4,0,12,0" />
                <TextBlock Text="端口:"
                           VerticalAlignment="Center" />
                <TextBox x:Name="txtPort"
                         Width="70"
                         Text="5000"
                         Margin="4,0,12,0" />
                <TextBlock Text="DeviceID:"
                           VerticalAlignment="Center" />
                <TextBox x:Name="txtDeviceId"
                         Width="50"
                         Text="0"
                         Margin="4,0,12,0" />
                <Button x:Name="btnStart"
                        Content="启动监听"
                        Width="90"
                        Click="btnStart_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="btnStop"
                        Content="停止"
                        Width="70"
                        Click="btnStop_Click"
                        IsEnabled="False" />
                <TextBlock x:Name="txtState"
                           Text="未启动"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           FontWeight="Bold" />
                <CheckBox x:Name="chkAutoScroll"
                          Content="自动滚动"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="24,0,0,0" />
            </StackPanel>
        </Border>

        <!-- 消息交互栏：虚拟化 ListView -->
        <ListView Grid.Row="1"
                  x:Name="lstMessages"
                  FontFamily="Consolas"
                  FontSize="12"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.IsDeferredScrollingEnabled="True">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="时间"
                                    Width="95"
                                    DisplayMemberBinding="{Binding TimeText}" />
                    <GridViewColumn Header="方向"
                                    Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DirectionText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="Gray" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Direction}"
                                                             Value="Receive">
                                                    <Setter Property="Foreground"
                                                            Value="#1565C0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Direction}"
                                                             Value="Send">
                                                    <Setter Property="Foreground"
                                                            Value="#2E7D32" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Direction}"
                                                             Value="Error">
                                                    <Setter Property="Foreground"
                                                            Value="#C62828" />
                                                    <Setter Property="FontWeight"
                                                            Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="消息"
                                    Width="90"
                                    DisplayMemberBinding="{Binding MessageText}" />
                    <GridViewColumn Header="内容"
                                    Width="720"
                                    DisplayMemberBinding="{Binding Content}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 主动上报 -->
        <Border Grid.Row="2"
                BorderBrush="#DDD"
                BorderThickness="1"
                Padding="8"
                Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="CEID:"
                           VerticalAlignment="Center" />
                <TextBox x:Name="txtCeid"
                         Width="60"
                         Text="1"
                         Margin="4,0,12,0" />
                <TextBlock Text="RPTID:"
                           VerticalAlignment="Center" />
                <TextBox x:Name="txtRptid"
                         Width="70"
                         Text="1001"
                         Margin="4,0,12,0" />
                <TextBlock Text="变量值:"
                           VerticalAlignment="Center" />
                <TextBox x:Name="txtValue"
                         Width="160"
                         Text="LOT_001"
                         Margin="4,0,12,0" />
                <Button Content="主动上报 S6F11"
                        Width="130"
                        Click="btnReport_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
